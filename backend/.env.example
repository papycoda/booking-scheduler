# ============================================================================
# Bookie Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control - it contains secrets!
# ============================================================================

# REQUIRED SETTINGS ===========================================================

# JWT signing secret - MUST be at least 32 characters long
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long

# Your frontend URL (for CORS and redirect URLs)
FRONTEND_URL=http://localhost:3000

# Environment: development or production
ENVIRONMENT=development

# PostgreSQL database connection string (with asyncpg driver)
# Local Docker example: postgresql+asyncpg://booking_scheduler:booking_scheduler@127.0.0.1:5433/booking_scheduler
# Production example: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/booking_scheduler

# Redis connection string
# Local Docker: redis://127.0.0.1:6379
# Production with password: redis://:password@host:6379/0
REDIS_URL=redis://127.0.0.1:6379

# Paystack payment processing
# Get from: https://dashboard.paystack.co/#/settings/keys
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key-here

# Optional override for webhook verification. Paystack normally signs webhook
# events with PAYSTACK_SECRET_KEY, so leave this blank unless deliberately using
# a separate compatible secret.
PAYSTACK_WEBHOOK_SECRET=

# OPTIONAL SETTINGS ==========================================================

# Demo Mode - Testing without real payments (development only!)
# When enabled, users listed in DEMO_ADMIN_EMAILS can use the demo payment flow
DEMO_MODE=false
DEMO_ADMIN_EMAILS=test@example.com,admin@example.com

# Email notifications via Resend (required in production)
# Get API key from: https://resend.com/api-keys
# FROM_EMAIL must be a verified domain in Resend
RESEND_API_KEY=re_your-resend-api-key-here
FROM_EMAIL=noreply@yourdomain.com

# WhatsApp front desk via Twilio (optional until connecting a real number)
# Get these values from the Twilio Console or WhatsApp Sandbox.
TWILIO_ACCOUNT_SID=AC_your-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM_NUMBER=+14155238886

# UPLOAD SETTINGS (usually no need to change) =================================
UPLOAD_DIR=backend/uploads
UPLOAD_BASE_URL=/uploads
MAX_INSPO_IMAGES=4
MAX_INSPO_IMAGE_BYTES=5242880
MAX_INSPO_TOTAL_BYTES=15728640

# Inspiration image storage. Keep database for local development; use
# cloudinary in production so image bytes do not consume PostgreSQL storage.
IMAGE_STORAGE_PROVIDER=database
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# TOKEN EXPIRY (usually no need to change) ====================================
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
